---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmPopulate from '../../components/CrmPopulate.astro';
// CRM subunit (skeleton v0.3 §3.3), spirits/bev-alc-first, operator voice (A-15).
// Public name "CRM" (A-6). Pricing → Contact only (A-8).
// FLAG: capability claims drawn from the skeleton outline, kept conservative;
// verify against crm-os canon before live (out of this session's repo scope).
const feats = [
  { n: '01', h: 'Accounts & contacts, the way spirits sells', p: 'Every retail outlet, on-premise account, distributor, and buyer in one place — keyed the way our world actually works, not bent out of a generic sales CRM.' },
  { n: '02', h: 'Depletion tracking', p: 'Track what’s actually moving through accounts, not just what shipped. The number your distributor’s report buries.' },
  { n: '03', h: 'Reps, distributors & territory', p: 'Call activity, visit logs, distributor relationships, and territory workflow built for a field team — so you know where the reps are and what they moved.' },
  { n: '04', h: 'Brand-level walls', p: 'Run more than one label? Each brand sees only its own world. Clean separation, no cross-contamination.' },
];
---
<BaseLayout
  title="CRM"
  description="A CRM that knows what a depletion is. Accounts, distributors, depletions, rep activity, and territory workflow — built for how spirits and bev-alc brands actually sell. Book a demo.">
  <section class="section">
    <div class="wrap">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — CRM</span>
        <h1>A CRM that knows what a <span class="g">depletion</span> is.</h1>
        <p class="lede">You’re running accounts out of spreadsheets and a CRM built for software reps. It doesn’t know what a distributor is, what a depletion is, or that you can’t ship into a dry county. This one does — because I run my own brands on it.</p>
        <div class="prod-cta">
          <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Book a demo →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>

      <div class="prod-sec rule problem">
        <span class="eyebrow">// The problem</span>
        <p class="lede">A generic CRM treats a liquor store and a SaaS lead the same way. Your reality — outlets, distributors, depletions, territories — gets crammed into fields that were never built for it. So the data’s a mess, and you stop trusting it.</p>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head"><h2>Every account, distributor, and depletion in one place — and the ones slipping, flagged.</h2></div>
        <div class="feats" data-reveal-stagger>
          {feats.map((f) => (
            <div class="feat card">
              <span class="feat__n">{f.n}</span>
              <h3>{f.h}</h3>
              <p class="mut">{f.p}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CrmPopulate />

  <section class="section">
    <div class="wrap">
      <div class="prod-sec" style="margin-top:0; padding-top:0;">
        <div class="prod-sec__head">
          <span class="eyebrow">// Built for the category</span>
          <h2>Distributors, depletions, and SKUs are first-class — not customizations.</h2>
        </div>
        <div class="shot"><span class="shot__label">CRM walkthrough — screenshot slot</span></div>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>See it running on your accounts.</h2>
      <p class="mut">Demos are real — I’ll show you the system with category data that looks like yours. Pricing’s scoped to the brand; tell me what you need.</p>
      <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Book a demo →</a>
    </div>
  </section>
</BaseLayout>
