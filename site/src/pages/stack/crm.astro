---
import BaseLayout from '../../layouts/BaseLayout.astro';
// CRM subunit (skeleton v0.3 §3.3). Public name "CRM" (A-6). Pricing → Contact
// only (A-8). Capability claims below are drawn from the skeleton outline and
// kept conservative; FLAG: final feature claims must be verified against
// crm-os canon before this copy goes live (crm-os is outside this session's
// repo scope — verification is a pre-cutover checklist item, not a build blocker).
const feats = [
  { n: '01', h: 'Accounts & contacts, CPG-shaped', p: 'Every retail outlet, distributor, and buyer in one place — keyed the way CPG actually works, not bent out of a generic sales CRM.' },
  { n: '02', h: 'Depletion tracking', p: 'Track what’s actually moving through accounts, not just what shipped. The number your distributor’s report buries.' },
  { n: '03', h: 'Rep activity & territory', p: 'Call activity, visit logs, and territory workflow built for a field team — so you know where the reps are and what they moved.' },
  { n: '04', h: 'Brand-level walls', p: 'Run more than one brand? Each one sees only its own world. Clean separation, no cross-contamination.' },
];
---
<BaseLayout
  title="CRM"
  description="A CRM that knows what a depletion is. Accounts, contacts, depletions, rep activity, and territory workflow — built for how CPG and spirits brands actually sell. Book a demo.">
  <section class="section">
    <div class="wrap">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — CRM</span>
        <h1>A CRM that knows what a <span class="g">depletion</span> is.</h1>
        <p class="lede">You’re running accounts out of spreadsheets and a CRM built for software sales reps. It doesn’t know what a distributor is, what a depletion is, or how your category really moves. This one does.</p>
        <div class="prod-cta">
          <a href="/contact" class="btn btn--primary">Book a demo →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>

      <div class="prod-sec rule problem">
        <span class="eyebrow">// The problem</span>
        <p class="lede">A generic CRM treats a liquor store and a SaaS lead the same way. Your reality — outlets, distributors, depletions, territories — gets crammed into fields that were never built for it. So the data’s a mess, and you stop trusting it.</p>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head"><h2>What it does</h2></div>
        <div class="feats">
          {feats.map((f) => (
            <div class="feat card">
              <span class="feat__n">{f.n}</span>
              <h3>{f.h}</h3>
              <p class="mut">{f.p}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head">
          <span class="eyebrow">// Built for CPG</span>
          <h2>Keys, SKUs, and distributors are first-class — not customizations.</h2>
        </div>
        <div class="shot"><span class="shot__label">CRM walkthrough — screenshot slot</span></div>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>See it running on your accounts.</h2>
      <p class="mut">Demos are real — we’ll show you the system with category data that looks like yours. Pricing is scoped to the brand; tell us what you need.</p>
      <a href="/contact" class="btn btn--primary">Book a demo →</a>
    </div>
  </section>
</BaseLayout>
