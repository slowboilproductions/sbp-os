---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Image Creation subunit (skeleton v0.3 §3.6 / A-11), spirits-first, operator
// voice (A-15). ONE subunit covering BOTH still and motion. Pricing → Contact
// (A-8). HARD CONSTRAINT: Black Company appears NOWHERE — no BC reference.
const feats = [
  { n: '01', h: 'Still imagery', p: 'Bottle shots, lifestyle scenes, social-ready angles, hero imagery — trained on your brand, consistent across every channel, ready when the campaign is.' },
  { n: '02', h: 'Motion', p: 'Short-form motion and video from the same trained model — the scroll-stopping stuff, without a production crew on the calendar.' },
];
---
<BaseLayout
  title="Image Creation"
  description="Bottle shots and motion that look like a $50,000 studio day — from one model trained on your brand. Not a stock photo with your logo on it. Part of the Slow Boil stack.">
  <section class="section">
    <div class="wrap">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — Image Creation</span>
        <h1>Photography that looks like a $50,000 studio shoot.<br /><span class="g">It isn’t one. That’s the point.</span></h1>
        <p class="lede">Everybody wants to use AI for the images and motion they put out. The problem: most AI platforms have no idea what your product actually is — and a handful of reference shots won’t fix it. The only thing that works is training the model on your brand. That’s what we do for you — so every still and every clip you generate comes out inside your brand’s guardrails, every time.</p>
        <div class="prod-cta">
          <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Start a conversation →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head"><h2>Still and motion, from one engine.</h2></div>
        <div class="feats">
          {feats.map((f) => (
            <div class="feat card">
              <span class="feat__n">{f.n}</span>
              <h3>{f.h}</h3>
              <p class="mut">{f.p}</p>
            </div>
          ))}
        </div>
        <div class="shot ic-shot"><span class="shot__label">Before / after &amp; sample reel — visual slot</span></div>
      </div>

      <div class="prod-sec problem">
        <span class="eyebrow">// One engine, two outputs</span>
        <p class="lede">Because the same brand-trained model drives both the stills and the motion, everything matches — the photo, the clip, the next campaign. That’s why it’s one offering, not two vendors who never talk.</p>
        <p class="mut od-note">No price on the page — every shoot’s different. <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="ilink">Tell me what you’re launching.</a></p>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>Brand-true imagery, on your timeline.</h2>
      <p class="mut">Stills, motion, or both — scoped to the brand. Start with a conversation.</p>
      <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Start a conversation →</a>
    </div>
  </section>

  <style>
    .ilink { color: var(--grn); border-bottom: 1px solid var(--grn-deep); }
    .od-note { margin-top: var(--s4); }
    .ic-shot { margin-top: var(--s6); }
  </style>
</BaseLayout>
