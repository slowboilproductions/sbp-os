---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Marketing subunit (skeleton v0.3 §3.5), spirits-first, operator voice (A-15).
// Carries the original SBP offer (the legacy "two pillars": infrastructure +
// tailored strategy). A-9: Google-Ads optimization is ONE element inside
// digital — NEVER its own headline. Pricing → Contact (A-8); no number on page.
const infra = [
  { n: '01', h: 'Websites that convert', p: 'Fast, age-gated, compliant sites that turn visitors into contacts — on platforms you actually own. (You’re looking at one.)' },
  { n: '02', h: 'Bottle & product photography', p: 'Bottle shots and lifestyle scenes that look like a $50,000 studio day — AI-trained on your brand, delivered in a fraction of the time.' },
  { n: '03', h: 'Content & social', p: 'Calendars, captions, posts — in your brand voice and inside the alcohol-advertising rules, reviewed by a human before anything ships.' },
  { n: '04', h: 'Paid that moves cases', p: 'Age-gated paid social and search built around your conversion paths — plus the trade and distributor-facing channels that actually move product. Google-Ads optimization is part of the mix, not a magic trick.' },
];
---
<BaseLayout
  title="Marketing"
  description="Real marketing for developing spirits brands — strategy and positioning, websites, product photography, content, and digital that moves product. The same marketing arm I run for my own brands.">
  <section class="section">
    <div class="wrap">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — Marketing</span>
        <h1>Agency-grade marketing,<br /><span class="g">built for beverage alcohol.</span></h1>
        <p class="lede">The agency model wasn’t built for you — it was built to bill you. This is real marketing for a regulated category, run by someone who’s actually carried inventory, chased a distributor, and navigated three-tier.</p>
        <div class="prod-cta">
          <a href="/contact" class="btn btn--primary">Start a conversation →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head"><h2>The full stack — not a one-trick shop.</h2></div>
        <div class="feats">
          {infra.map((b) => (
            <div class="feat card">
              <span class="feat__n">{b.n}</span>
              <h3>{b.h}</h3>
              <p class="mut">{b.p}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="prod-sec problem">
        <span class="eyebrow">// Built for a regulated category</span>
        <p class="lede">Most marketers don’t know you can’t ship into a dry county, can’t make a health claim, and live or die by the distributor relationship. I do. Age-gating, three-tier, on- vs off-premise, trade marketing — it’s built into the work, not bolted on after legal flags it.</p>
      </div>

      <div class="prod-sec problem">
        <span class="eyebrow">// Plus the strategy underneath</span>
        <p class="lede">Positioning, audience, content pillars, conversion paths — the strategy work that takes a consultancy four weeks, grounded in your category and your distribution reality. Not a Google Doc that gets read once. A living foundation everything else builds on.</p>
      </div>

      <div class="prod-sec problem">
        <span class="eyebrow">// How it stays affordable</span>
        <p class="lede">I train AI on your brand so every asset already sounds and looks like you — that’s the heavy lifting. The strategy and the taste stay human. You stop paying agency rates for the slow parts, and the price stays fair.</p>
        <p class="mut od-note">Want to know what fair looks like for your brand? <a href="/contact" class="ilink">Tell me what you need.</a></p>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>Marketing that respects the brand and the budget.</h2>
      <p class="mut">No rate card, no runaround — just a real answer once I know what you’re building.</p>
      <a href="/contact" class="btn btn--primary">Start a conversation →</a>
    </div>
  </section>

  <style>
    .ilink { color: var(--grn); border-bottom: 1px solid var(--grn-deep); }
    .od-note { margin-top: var(--s4); }
  </style>
</BaseLayout>
