---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmsStackWheel from '../../components/AmsStackWheel.astro';
// Marketing subunit (skeleton v0.3 §3.5), rebuilt on the operator's first-pass
// two-pillar structure (A-18): Infrastructure + Tailored Strategy + the weekly
// rhythm, operator's own copy, bev/alc-framed. Pricing analogies allowed
// (A-18 amends A-8: "half the cost" etc. OK; actual quote → Contact).
// A-9: Google Ads is one channel in the list, never a standalone headline.
const infra = [
  { h: 'Sites that convert.', label: 'Websites', p: 'Custom-built marketing sites that load fast, look right on every device, and turn visitors into customers — age-gated where the category requires it. Built on platforms you actually own, no proprietary lock-in.' },
  { h: 'Product shots that look like a $50,000 studio.', label: 'Photography', p: 'AI-trained on your brand. Bottle shots, lifestyle scenes, social-ready angles, hero imagery. The kind of photography that used to require a full studio day — delivered in a fraction of the time.' },
  { h: 'Content calendars that write themselves in your voice.', label: 'Content & Social', p: 'Social posts, captions, blog content, newsletters — generated from your brand voice, inside the alcohol-advertising rules, and reviewed by a human before anything ships.' },
  { h: 'Ads that actually move product.', label: 'Paid Advertising', p: 'Google, Meta, and platform-native advertising — age-gated and built around your conversion paths, optimized weekly, reported transparently.' },
  { h: 'Email that builds the list and runs the list.', label: 'Email Marketing', p: 'Welcome sequences, campaigns, automations. Every email reads like it came from your brand because it did — the system speaks your voice.' },
  { h: 'Reporting you can actually read.', label: 'Analytics', p: 'Weekly performance reports built for brand owners, not for analytics professionals. Real numbers. Plain language. Clear next steps.' },
];
const strategy = [
  { h: 'Who you are. Who you’re for. Why it matters.', label: 'Brand Positioning', p: 'Structured positioning that defines your brand’s place in the market — not a Google Doc that gets read once, but a living foundation every other piece of marketing builds on.' },
  { h: 'Specifically who you’re trying to reach.', label: 'Audience Definition', p: 'Not personas with stock photos. Real audience segments grounded in your category, your price point, and your distribution reality.' },
  { h: 'The three to five things you should be talking about.', label: 'Content Pillars', p: 'Topical authority territory, mapped specifically to your brand — the themes that compound your relevance over time.' },
  { h: 'How a stranger becomes a customer.', label: 'Conversion Paths', p: 'From first impression to first purchase to repeat purchase. Mapped, measured, optimized.' },
  { h: 'What you should be measuring.', label: 'Performance Frameworks', p: 'The metrics that actually predict growth in your category. Not vanity metrics, not industry-standard fluff — the numbers that tell you whether the work is working.' },
  { h: 'Who’s doing what, and what to do about it.', label: 'Competitive Analysis', p: 'Structured analysis of your competitive landscape — not a report you file away, but input that shapes every other piece of work.' },
];
const rhythm = [
  { day: 'Monday', h: 'Brief.', p: 'A 30-minute call. You tell us what you want this week.' },
  { day: 'Wednesday', h: 'Review.', p: 'Drafts, mockups, copy — ready for your judgment.' },
  { day: 'Friday', h: 'Ship.', p: 'Approved work goes live. Reports show what’s working.' },
];
---
<BaseLayout
  title="Marketing"
  description="Agency-grade marketing for beverage-alcohol brands — websites, $50k-studio photography, content, paid, and email, plus strategy work that takes consultancies four weeks, delivered in two hours.">
  <section class="section m-top">
    <!-- Marketing motion signature: multi-layer drift. Decorative sunset
         layers parallax at different speeds (slower than the foreground copy)
         as you scroll into the page. aria-hidden; static under reduced motion
         / no-JS, where it reads as a warm static backdrop. -->
    <div class="mdrift" aria-hidden="true">
      <span class="mdrift__layer mdrift__blob" data-drift="0.30"></span>
      <span class="mdrift__layer mdrift__grid" data-drift="0.16"></span>
      <span class="mdrift__layer mdrift__stripes" data-drift="0.46"></span>
    </div>
    <div class="wrap">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — Marketing</span>
        <h1>Agency-grade marketing,<br /><span class="g">built for beverage alcohol.</span></h1>
        <p class="lede">Real, professional marketing at a price point that won’t drain your tank before you ever get to market — run by someone who’s actually carried inventory, chased a distributor, and navigated three-tier.</p>
        <div class="prod-cta">
          <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Start a conversation →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>

      <AmsStackWheel />

      <div class="prod-sec rule problem">
        <span class="eyebrow">// Built for a regulated category</span>
        <p class="lede">Most marketers don’t know you can’t ship into a dry county, can’t make a health claim, and live or die by the distributor relationship. I do. Age-gating, three-tier, on- vs off-premise, trade marketing — it’s built into the work, not bolted on after legal flags it.</p>
        <p class="mut m-stakes">Hire a marketer who doesn’t know the category and you pay for their education — in flagged ads, compliance do-overs, and missed distributor windows. That’s the expensive way to learn what I already know.</p>
      </div>

      <!-- Pillar 01 -->
      <div class="prod-sec">
        <div class="prod-sec__head">
          <span class="eyebrow">// Pillar 01 — Infrastructure</span>
          <h2>Same services as a traditional agency. Half the cost.</h2>
          <p class="mut m-tag">Faster turnarounds. No 6-week kickoffs.</p>
        </div>
        <div class="m-grid" data-reveal-stagger>
          {infra.map((b) => (
            <div class="feat card">
              <span class="feat__n">{b.label}</span>
              <h3>{b.h}</h3>
              <p class="mut">{b.p}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pillar 02 -->
      <div class="prod-sec">
        <div class="prod-sec__head">
          <span class="eyebrow">// Pillar 02 — Tailored Strategy</span>
          <h2>Strategy that takes consultancies four weeks. Delivered in two hours.</h2>
        </div>
        <div class="m-grid" data-reveal-stagger>
          {strategy.map((b) => (
            <div class="feat card">
              <span class="feat__n">{b.label}</span>
              <h3>{b.h}</h3>
              <p class="mut">{b.p}</p>
            </div>
          ))}
        </div>
        <p class="m-kicker">“The template alone isn’t the moat. The template plus the system that turns its outputs into deployed reality — that’s the moat.”</p>
      </div>

      <!-- How we work -->
      <div class="prod-sec">
        <div class="prod-sec__head">
          <span class="eyebrow">// How we work</span>
          <h2>A weekly rhythm.</h2>
        </div>
        <div class="grid grid--3" data-reveal-stagger>
          {rhythm.map((r) => (
            <div class="feat card">
              <span class="feat__n">{r.day}</span>
              <h3>{r.h}</h3>
              <p class="mut">{r.p}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="prod-sec problem">
        <span class="eyebrow">// How it stays affordable</span>
        <p class="lede">We use AI to do the heavy lifting so we can offer real, professional marketing at a price that won’t drain your tank. The strategy and the taste stay human. You stop paying agency rates for the slow parts.</p>
        <p class="mut od-note">Want to know what fair looks like for your brand? <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="ilink">Tell me what you need.</a></p>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>Marketing that respects the brand and the budget.</h2>
      <p class="mut">No rate card, no runaround — just a real answer once I know what you’re building.</p>
      <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Start a conversation →</a>
    </div>
  </section>

  <style>
    .ilink { color: var(--grn); border-bottom: 1px solid var(--grn-deep); }
    .od-note { margin-top: var(--s4); }
    .m-tag { margin-top: var(--s3); }
    .m-stakes { margin-top: var(--s4); max-width: 60ch; }
    .m-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s5); }
    .m-kicker { font-family: var(--font-display); font-size: var(--t-lg); line-height: 1.4; color: var(--text-2); max-width: 60ch; margin-top: var(--s6); padding-left: var(--s5); border-left: 2px solid var(--grn); }
    @media (max-width: 900px) { .m-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .m-grid { grid-template-columns: 1fr; } }

    /* multi-layer drift backdrop (the Marketing motion signature) */
    .m-top { position: relative; overflow: hidden; }
    .m-top > .wrap { position: relative; z-index: 1; }
    .mdrift { position: absolute; inset: 0 0 auto 0; height: 760px; z-index: 0; pointer-events: none; }
    .mdrift__layer { position: absolute; display: block; will-change: transform; }
    .mdrift__blob {
      top: -14%; right: -12%; width: 64%; height: 620px;
      background: radial-gradient(50% 50% at 60% 40%, rgba(226,179,74,0.34), rgba(224,106,44,0.14) 55%, transparent 72%);
      filter: blur(6px);
    }
    .mdrift__grid {
      inset: 0; opacity: 0.5;
      background-image:
        linear-gradient(to right, rgba(75,46,32,0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(75,46,32,0.05) 1px, transparent 1px);
      background-size: 46px 46px;
      mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
    }
    .mdrift__stripes {
      left: -18%; top: 38%; width: 56%; height: 220px; transform: rotate(-8deg);
      background: linear-gradient(180deg,
        rgba(226,179,74,0.20) 0 33%, rgba(224,106,44,0.18) 33% 66%, rgba(75,46,32,0.16) 66% 100%);
      border-radius: 0 var(--r-lg) var(--r-lg) 0;
      filter: blur(2px);
      mask-image: linear-gradient(to right, #000, transparent);
      -webkit-mask-image: linear-gradient(to right, #000, transparent);
    }
    @media (max-width: 760px) { .mdrift { height: 560px; } .mdrift__blob { width: 90%; } }
  </style>

  <script>
    // Marketing signature — multi-layer drift. Each [data-drift] layer parallaxes
    // at its own fraction of scroll (all slower than the foreground copy). rAF-
    // throttled, transform-only. Skipped entirely under prefers-reduced-motion,
    // leaving the layers as a warm static backdrop.
    function initMarketingDrift() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const section = document.querySelector('.m-top');
      if (!section || section.dataset.driftWired) return;
      const layers = Array.from(section.querySelectorAll('[data-drift]'));
      if (!layers.length) return;
      section.dataset.driftWired = '1';
      let raf = 0;
      const onScroll = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const top = section.getBoundingClientRect().top;
          // only drift while the hero band is near the viewport
          if (top < -900) return;
          layers.forEach((l) => {
            const f = parseFloat(l.dataset.drift) || 0.2;
            l.style.transform = (l.classList.contains('mdrift__stripes') ? 'rotate(-8deg) ' : '') +
              'translate3d(0,' + (-top * f).toFixed(1) + 'px,0)';
          });
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      onScroll();
    }
    initMarketingDrift();
    document.addEventListener('astro:after-swap', initMarketingDrift);
  </script>
</BaseLayout>
