---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardPanel from '../../components/DashboardPanel.astro';
import ZPush from '../../components/ZPush.astro';
import DashConverge from '../../components/DashConverge.astro';
// Operational Dashboard subunit (skeleton v0.3 §3.4), spirits-first, operator
// voice (A-15). PUBLIC NAME "Operational Dashboard" ONLY — internal "Dash"
// never appears (A-6). Pricing → Contact (A-8). FLAG: verify claims against
// dash-os canon before live (out of this session's repo scope).
const feats = [
  { n: '01', h: 'Depletions & state tabs', p: 'What moved, where, this week — by state, by account, by SKU. The truth underneath the shipment number.' },
  { n: '02', h: 'Load-in & AR', p: 'What went in, what’s owed, what’s aging. The money picture next to the movement picture.' },
  { n: '03', h: 'Open orders & inventory', p: 'What’s in the pipeline and what’s on the shelf — so you’re not flying blind between distributor reports.' },
  { n: '04', h: 'One summary front page', p: 'The whole business on one screen at 7am. Drill in when a number looks wrong; otherwise just know.' },
];
---
<BaseLayout noindex
  title="Operational Dashboard"
  description="Sell-in vs sell-through truth — everywhere you're sold, in one picture. Depletions, load-in, AR, open orders, and inventory, normalized from the distributor feeds you already get. Book a demo.">
  <section class="section">
    <div class="wrap od-hero">
      <div class="prod-hero" data-anim="hero">
        <span class="eyebrow">// The Stack — Operational Dashboard</span>
        <h1>Right now, someone in your distillery has made a career out of <span class="g">Excel spreadsheet jockeying.</span></h1>
        <p class="lede">That person is either going to love this — or hate it. Hot take: there’s no longer any value-add in synthesizing operational data in Excel.</p>
        <p class="od-hp">And trust me, I get it. This industry has so many unconnected data sources: Park Street, VIP, multiple distributor warehouses, NABCA, Encompass, QuickBooks, your CRM, Meta campaigns.</p>
        <p class="od-hp">Our Operational Dashboard fixes all of it — hands-free (no more Excel), and built for the spirits industry.</p>
        <div class="prod-cta">
          <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Book a demo →</a>
          <a href="/ai#operational-dashboard" class="btn btn--mono">How we use AI here →</a>
          <a href="/stack" class="btn btn--ghost">Back to the Stack</a>
        </div>
      </div>
      <div class="od-hero__panel" data-anim="hero-panel">
        <DashboardPanel title="operational-dashboard / summary" />
      </div>
    </div>
  </section>

  <DashConverge />

  <section class="section">
    <div class="wrap">
      <div class="problem">
        <span class="eyebrow">// The problem</span>
        <p class="lede">Sell-in is what you shipped. Sell-through is what actually sold. Most brands only see the first one clearly — and find out about the second one too late to do anything about it.</p>
      </div>

      <div class="prod-sec">
        <div class="prod-sec__head">
          <h2>No more Excel spreadsheets telling you what the weather is outside.</h2>
          <p class="mut od-note">Real information that creates value by cutting across sources — and gives you <strong>actionable</strong> outputs to move your business forward.</p>
        </div>
        <div class="feats" data-reveal-stagger>
          {feats.map((f) => (
            <div class="feat card">
              <span class="feat__n">{f.n}</span>
              <h3>{f.h}</h3>
              <p class="mut">{f.p}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- OD motion signature: z-axis push — the summary front page comes forward
       as you scroll into it (the whole business arriving on one screen). -->
  <section class="section section--band od-zsec">
    <div class="wrap">
      <div class="prod-sec__head center od-zhead">
        <span class="eyebrow">// One screen, 7am</span>
        <h2>The whole business, coming forward on one screen.</h2>
        <p class="mut od-note od-zlead">Depletions, load-in, AR, open orders, inventory — the summary front page you check before coffee. Drill in when a number looks wrong; otherwise, just know.</p>
      </div>
      <ZPush label="Operational Dashboard summary panel scaling forward as you scroll">
        <DashboardPanel title="operational-dashboard / summary front page" />
      </ZPush>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prod-sec" style="margin-top:0; padding-top:0;">
        <div class="prod-sec__head">
          <span class="eyebrow">// Data in, answers out</span>
          <h2>It eats the feeds you already get.</h2>
          <p class="mut od-note">Distributor drops, market data, the spreadsheets in your inbox — normalized into one picture instead of one more thing to reconcile by hand.</p>
        </div>
        <div class="shot"><span class="shot__label">Operational Dashboard — screenshot slot (the strongest single asset on the site)</span></div>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap cta-band">
      <h2>See your distribution in one picture.</h2>
      <p class="mut">I’ll walk you through it live. Pricing’s scoped to the brand — tell me what you’re working with.</p>
      <a href="mailto:hello@slowboilproductions.com?subject=Slow%20Boil%20inquiry" class="btn btn--primary">Book a demo →</a>
    </div>
  </section>

  <style>
    .od-hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--s8); align-items: center; }
    .od-hero__panel { width: 100%; }
    .od-note { margin-top: var(--s4); max-width: 52ch; }
    .od-hp { margin-top: var(--s4); max-width: 54ch; }

    /* z-push showcase */
    .od-zhead { margin-inline: auto; }
    .od-zhead .od-zlead { margin-inline: auto; }
    .od-zsec .zpush { max-width: 760px; margin: var(--s7) auto 0; }
    @media (max-width: 860px) {
      .od-hero { grid-template-columns: 1fr; gap: var(--s6); }
      .od-hero__panel { order: 3; }
    }
  </style>
</BaseLayout>
