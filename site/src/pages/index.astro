---
import BaseLayout from '../layouts/BaseLayout.astro';
// COMING-SOON HOLDING PAGE (operator, SBP-W9). Temporary front door while the
// full site finishes (screenshots / brand images pending). Rendered with the
// BaseLayout `bare` chrome (no nav, no motion islands) so none of the
// unfinished pages are advertised — but the Google-Ads destination compliance
// set is kept INLINE here: business name (Slow Boil Productions LLC),
// Charlotte NC (A-10), and links to Privacy / Terms / Contact (HTTPS +
// mobile-responsive come from the host + base styles). The headline is the
// operator's call. The image is SWAP-READY: drop a file at
// /public/coming-soon/hero.png — see that folder's README. NOTE: this branch is the HOLDING build; the real homepage
// lives on `main` / the build branch. Do NOT merge this branch into `main`.
const year = new Date().getFullYear();
---
<BaseLayout
  bare
  title="Slow Boil Productions"
  description="Slow Boil Productions — the marketing and the tools developing spirits brands need to compete. Something's coming.">
  <section class="cs">
    <div class="cs__inner">
      <a href="/" class="cs__brand" aria-label="Slow Boil Productions — home">
        <img src="/logo-dark.png" alt="Slow Boil Productions" class="cs__logo" width="232" height="229" />
      </a>
      <span class="cs__eyebrow mono">// Slow Boil Productions</span>
      <h1 class="cs__line">I hear the train <span class="cs__g">a-comin&rsquo;</span>&hellip;</h1>

      <figure class="cs__frame">
        <img src="/coming-soon/hero.png" alt="" class="cs__img" width="524" height="519" />
      </figure>
    </div>

    <footer class="cs__ft">
      <span class="cs__ftname">Slow Boil Productions LLC</span>
      <span class="cs__sep" aria-hidden="true">·</span>
      <span class="mono cs__loc">Charlotte, North Carolina</span>
      <nav class="cs__legal" aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/contact">Contact</a>
      </nav>
      <span class="cs__copy mono">&copy; {year}</span>
    </footer>
  </section>

  <style>
    .cs {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--s7);
      text-align: center;
      padding: var(--s7) var(--s5) var(--s5);
    }
    .cs__inner { display: flex; flex-direction: column; align-items: center; gap: var(--s5); }
    .cs__logo { height: 64px; width: auto; opacity: 0.95; }
    .cs__eyebrow {
      color: var(--mut);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-size: var(--t-eyebrow);
    }
    .cs__line {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(2.2rem, 1.1rem + 5vw, 4.4rem);
      line-height: 1.04;
      color: var(--text);
      max-width: 18ch;
      margin-inline: auto;
    }
    .cs__g { color: var(--grn); white-space: nowrap; }

    .cs__frame {
      width: min(560px, 92vw);
      border: 1px dashed var(--line-2);
      border-radius: var(--r-lg);
      background: var(--panel);
      padding: var(--s3);
      box-shadow: var(--shadow-soft);
    }
    .cs__img {
      width: 100%;
      height: auto;
      border-radius: var(--r);
      display: block;
    }

    .cs__ft {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--s3) var(--s4);
      color: var(--mut);
      font-size: var(--t-sm);
    }
    .cs__ftname { color: var(--text-2); }
    .cs__sep { color: var(--line-2); }
    .cs__legal { display: inline-flex; gap: var(--s4); }
    .cs__legal a {
      color: var(--text-2);
      border-bottom: 1px solid transparent;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
    .cs__legal a:hover { color: var(--grn); border-color: var(--grn-deep); }

    @media (max-width: 560px) {
      .cs { gap: var(--s6); }
      .cs__ft { flex-direction: column; gap: var(--s2); }
      .cs__sep { display: none; }
    }
  </style>
</BaseLayout>
