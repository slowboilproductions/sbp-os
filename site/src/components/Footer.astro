---
// Footer = the Google-Ads destination compliance set, on every page by
// construction (skeleton v0.3 §3, design-directions constants): business
// name (Slow Boil Productions LLC), Charlotte NC (A-10), contact, privacy,
// terms. HTTPS + mobile-responsive are delivered by the host + base styles.
const year = new Date().getFullYear();
const stackLinks = [
  { href: '/stack/marketing', label: 'Marketing' },
  { href: '/stack/crm', label: 'CRM' },
  { href: '/stack/operational-dashboard', label: 'Operational Dashboard' },
  { href: '/stack/image-creation', label: 'Image Creation' },
];
---
<footer class="ft">
  <div class="wrap ft__grid">
    <div class="ft__brand">
      <a href="/" class="ft__logo" aria-label="Slow Boil Productions — home"><img src="/logo-dark.png" alt="Slow Boil Productions" class="ft__logoimg" width="232" height="229" /></a>
      <p class="ft__line">Built by a brand owner, for other brand owners. The marketing and the tools developing spirits brands need to compete.</p>
      <p class="ft__loc mono">Charlotte, North Carolina</p>
    </div>

    <nav class="ft__col" aria-label="The Stack">
      <h4 class="ft__h">The Stack</h4>
      {stackLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <nav class="ft__col" aria-label="Company">
      <h4 class="ft__h">Company</h4>
      <a href="/stack">The Stack</a>
      <a href="/proof">Proof</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <nav class="ft__col" aria-label="Legal">
      <h4 class="ft__h">Legal &amp; Contact</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="mailto:hello@slowboilproductions.com">hello@slowboilproductions.com</a>
    </nav>
  </div>

  <div class="wrap ft__bottom">
    <span>© {year} Slow Boil Productions LLC. All rights reserved.</span>
    <span class="mono">Charlotte, NC · slowboilproductions.com</span>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--line); background: var(--bg-2); padding-top: var(--s8); margin-top: var(--s9); }
  .ft__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: var(--s6); padding-bottom: var(--s7); }
  .ft__logo { display: inline-flex; align-items: center; }
  .ft__logoimg { height: 84px; width: auto; opacity: 0.95; }
  .ft__line { color: var(--mut); font-size: var(--t-sm); margin-top: var(--s4); max-width: 34ch; line-height: var(--leading); }
  .ft__loc { color: var(--text-2); font-size: var(--t-sm); margin-top: var(--s4); }
  .ft__h { font-family: var(--font-mono); font-size: var(--t-eyebrow); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mut); font-weight: 500; margin-bottom: var(--s4); }
  .ft__col { display: flex; flex-direction: column; gap: 11px; }
  .ft__col a { color: var(--text-2); font-size: var(--t-sm); width: fit-content; transition: color var(--dur-fast) var(--ease); }
  .ft__col a:hover { color: var(--grn); }
  .ft__bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--s4); padding-block: var(--s5); border-top: 1px solid var(--line); color: var(--mut); font-size: var(--t-sm); }

  @media (max-width: 860px) {
    .ft__grid { grid-template-columns: 1fr 1fr; gap: var(--s6) var(--s5); }
    .ft__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .ft__bottom { flex-direction: column; align-items: flex-start; gap: var(--s2); }
  }
</style>
