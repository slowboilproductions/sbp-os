---
// The "instrument panel" — the live-ops hero object (design-directions v0.3:
// UI-screenshot-as-hero, the stack shown *running*, A-12). Static + accessible
// now; the Step-2 motion layer animates it (counters tick, chart draws in,
// LIVE pulses) via a progressive-enhancement island — no dependency here.
//
// NOTE: figures are ILLUSTRATIVE placeholders (per the ratified mock README),
// not real client data. Real metrics replace these only when they exist and
// are cleared for publication.
const bars = [42, 55, 48, 67, 60, 78, 71, 88, 82, 96];
const { title = 'operational-dashboard / sell-through' } = Astro.props;
---
<div class="dp panel" data-anim="dashboard" aria-label="Illustration of the Operational Dashboard">
  <div class="dp__top">
    <span class="dp__dot" aria-hidden="true"></span>
    <span class="dp__dot" aria-hidden="true"></span>
    <span class="dp__dot" aria-hidden="true"></span>
    <span class="dp__title mono">{title}</span>
    <span class="live dp__live">LIVE</span>
  </div>
  <div class="dp__body">
    <div class="dp__stats">
      <div class="dp__stat">
        <div class="dp__k mono">Depletions</div>
        <div class="dp__v mono g" data-count="18.4" data-suffix="%" data-prefix="+">+18.4%</div>
      </div>
      <div class="dp__stat">
        <div class="dp__k mono">Accounts</div>
        <div class="dp__v mono" data-count="1204">1,204</div>
      </div>
      <div class="dp__stat">
        <div class="dp__k mono">Coverage</div>
        <div class="dp__v mono g" data-count="92" data-suffix="%">92%</div>
      </div>
    </div>
    <div class="dp__chart" role="img" aria-label="Sell-in versus sell-through trending up across the year">
      {bars.map((h) => <span class="dp__bar" style={`height:${h}%`}></span>)}
    </div>
    <div class="dp__legend mono">
      <span>Q1</span><span>sell-in vs sell-through</span><span>Q4</span>
    </div>
  </div>
</div>

<style>
  .dp { overflow: hidden; box-shadow: var(--shadow-panel); }
  .dp__top { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .dp__dot { width: 11px; height: 11px; border-radius: 50%; background: var(--line-2); }
  /* live/positive values read avocado (the live-data state color) */
  .dp .dp__v.g { color: var(--avocado); }
  .dp__title { font-size: var(--t-eyebrow); color: var(--mut); margin-left: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dp__live { margin-left: auto; font-size: 10px; }
  .dp__body { padding: 20px; }
  .dp__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 18px; }
  .dp__stat { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
  .dp__k { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mut); }
  .dp__v { font-weight: 600; font-size: 22px; margin-top: 6px; }
  .dp__chart { height: 118px; display: flex; align-items: flex-end; gap: 7px; padding-top: 6px; }
  .dp__bar { flex: 1; background: linear-gradient(180deg, var(--gold), var(--orange) 55%, var(--brown)); border-radius: 3px 3px 0 0; opacity: 0.92; }
  .dp__legend { font-size: 10px; color: var(--mut); margin-top: 10px; display: flex; justify-content: space-between; }
  @media (max-width: 760px) {
    .dp__v { font-size: 19px; }
    .dp__chart { height: 96px; }
  }
</style>
