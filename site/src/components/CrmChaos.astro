---
// CRM CHAOS → ZEN — the CRM page's signature motion (operator-designed, W7).
// Scattered "nuggets" of field-sales data (account, last visit, reorder, a
// buyer's favorite team, an event...) jitter and overlap all over the stage —
// the chaos of a rep's life. As you scroll through, the noise FUNNELS into a
// central CRM and disappears, resolving to calm. Sets up "street-level
// intelligence": everything the field generates, pulled into one place.
//
// Nugget content is ILLUSTRATIVE placeholder (neutral outlets/details, NOT real
// brands or people) — same discipline as CrmPopulate.
//
// GUARDRAILS: the stage is aria-hidden decoration; the meaning is carried by the
// visible eyebrow + zen line + an sr-only sentence (all real text), plus the
// feature content below. transform/opacity-only; one rAF-throttled scroll island,
// no scroll-jack (it funnels as the section passes through view). Jitter is CSS
// keyframes, killed under prefers-reduced-motion by the global reset; the scroll
// funnel early-returns under reduced motion, leaving a static scattered field
// with the zen takeaway shown. Nothing here is compliance chrome.
const nuggets = [
  { k: 'Account',      v: 'Eastside Wine & Spirits',     x: 10, y: 16 },
  { k: 'Last visit',   v: '12 days ago',                 x: 68, y: 9  },
  { k: 'Reorder due',  v: 'Harbor Beverage',             x: 39, y: 7  },
  { k: 'New buyer',    v: 'Midtown Bottle Co.',          x: 80, y: 30 },
  { k: 'Last order',   v: '9 cases · Aug 2',             x: 7,  y: 44 },
  { k: 'Buyer',        v: 'die-hard Panthers fan',       x: 58, y: 38 },
  { k: 'Event',        v: 'Tasting @ Eastside — Fri 6p', x: 28, y: 60 },
  { k: 'Address',      v: '1420 Central Ave',            x: 77, y: 63 },
  { k: 'Depletion',    v: '↓ 8% MoM',                    x: 13, y: 74 },
  { k: 'Distributor',  v: 're-up pending',               x: 45, y: 80 },
  { k: 'Note',         v: 'comps the bartender',         x: 86, y: 49 },
  { k: 'Today',        v: '3 stops logged',              x: 23, y: 32 },
  { k: 'Stockout risk',v: 'Uptown Cellars',              x: 63, y: 72 },
  { k: 'Reminder',     v: 'buyer’s birthday next week',  x: 34, y: 25 },
];
// deterministic jitter params per nugget (so the chaos looks organic, not uniform)
const jitter = (i) => {
  const sx = i % 2 ? 1 : -1, sy = i % 3 === 0 ? -1 : 1;
  return {
    jx: sx * (7 + (i % 3) * 5),
    jy: sy * (6 + (i % 4) * 4),
    dur: (3.1 + (i % 5) * 0.55).toFixed(2),
    delay: (-(i * 0.43)).toFixed(2),
  };
};
---
<section class="crm-chaos section" id="crm-chaos">
  <div class="wrap">
    <span class="eyebrow crm-chaos__eyebrow">// A day in the field</span>

    <div class="crm-chaos__stage" aria-hidden="true">
      <div class="crm-chaos__hub">
        <span class="crm-chaos__bar"><i></i><i></i><i></i></span>
        <span class="crm-chaos__hublabel">CRM</span>
      </div>
      {nuggets.map((n, i) => {
        const j = jitter(i);
        return (
          <div class="cnug" style={`left:${n.x}%;top:${n.y}%`}>
            <div class="cnug__in" style={`--jx:${j.jx}px;--jy:${j.jy}px;--dur:${j.dur}s;animation-delay:${j.delay}s`}>
              <span class="cnug__k">{n.k}</span>
              <span class="cnug__v">{n.v}</span>
            </div>
          </div>
        );
      })}
    </div>

    <p class="crm-chaos__zen">The noise funnels into one place — and goes quiet.</p>
    <p class="sr-only">Everything a sales rep juggles in the field — accounts, visits, orders, reorders, even the buyer’s favorite team — funneled into one CRM, so it becomes street-level intelligence instead of scattered notes.</p>
  </div>
</section>

<style>
  .crm-chaos { padding-top: var(--s7); padding-bottom: var(--s6); }
  .crm-chaos__eyebrow { display: block; text-align: center; }

  .crm-chaos__stage {
    position: relative; width: 100%; height: 540px; margin: var(--s5) auto 0;
    overflow: hidden;
  }

  /* the funnel destination — a little CRM window in the center */
  .crm-chaos__hub {
    position: absolute; left: 50%; top: 50%; z-index: 0;
    width: 168px; padding: 0 0 16px; border-radius: var(--r-lg);
    background: var(--bg-2); border: 1px solid var(--line-2);
    box-shadow: 0 10px 34px rgba(75, 46, 32, 0.16);
    transform: translate(-50%, -50%) scale(calc(1 + 0.16 * var(--funnel, 0)));
    transition: box-shadow var(--dur) var(--ease);
  }
  .crm-chaos__bar {
    display: flex; gap: 5px; padding: 9px 11px; border-bottom: 1px solid var(--line-2);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .crm-chaos__bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); }
  .crm-chaos__bar i:first-child { background: var(--orange); }
  .crm-chaos__bar i:nth-child(2) { background: var(--gold); }
  .crm-chaos__hublabel {
    display: block; text-align: center; margin-top: 16px;
    font-family: var(--font-display); font-weight: 700; font-size: 30px;
    letter-spacing: 0.04em; color: var(--text);
  }
  /* a steel ring that blooms as the chaos resolves into the hub */
  .crm-chaos__hub::after {
    content: ""; position: absolute; inset: -10px; border-radius: calc(var(--r-lg) + 10px);
    border: 2px solid #8C99A2; opacity: var(--funnel, 0); pointer-events: none;
  }

  .cnug {
    position: absolute; z-index: 1; will-change: transform, opacity;
    transform: translate(0, 0);
  }
  .cnug__in {
    display: block; white-space: nowrap;
    background: var(--bg); border: 1px solid var(--line-2); border-radius: var(--r);
    padding: 6px 11px; box-shadow: 0 4px 14px rgba(75, 46, 32, 0.10);
    animation: cnug-float var(--dur, 4s) ease-in-out infinite alternate;
  }
  .cnug__k {
    display: block; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--grn);
  }
  .cnug__v { font-size: 13px; color: var(--text); }

  @keyframes cnug-float {
    from { transform: translate(0, 0) rotate(-1deg); }
    to   { transform: translate(var(--jx, 8px), var(--jy, 6px)) rotate(1.4deg); }
  }

  .crm-chaos__zen {
    text-align: center; margin-top: var(--s5);
    font-family: var(--font-display); font-size: var(--t-lg); color: var(--text-2);
  }
  /* under motion, the zen line fades in only as the funnel completes */
  .crm-chaos.is-motion .crm-chaos__zen { opacity: 0; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 680px) {
    .crm-chaos__stage { height: 460px; }
    .cnug__v { font-size: 12px; }
    /* thin the field on small screens so it reads as chaos, not a wall */
    .cnug:nth-child(odd):nth-child(n+10) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cnug__in { animation: none; }
  }
</style>

<script>
  function initCrmChaos() {
    const sec = document.getElementById('crm-chaos') as HTMLElement | null;
    if (!sec || sec.dataset.wired) return;
    sec.dataset.wired = '1';
    const stage = sec.querySelector('.crm-chaos__stage') as HTMLElement;
    const zen = sec.querySelector('.crm-chaos__zen') as HTMLElement | null;
    const nugs = Array.from(sec.querySelectorAll('.cnug')) as HTMLElement[];

    // reduced motion: leave the field static (jitter off via CSS) and show the
    // zen takeaway as-is — no funnel.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sec.classList.add('is-motion');

    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = sec.getBoundingClientRect();
      const vh = window.innerHeight || 800;
      const center = r.top + r.height / 2;
      const startY = vh * 0.95, endY = vh * 0.42;
      const p = clamp((startY - center) / (startY - endY));
      const funnel = clamp((p - 0.4) / 0.5);   // chaos until ~40%, fully funneled by ~90%
      stage.style.setProperty('--funnel', funnel.toFixed(3));
      const cw = stage.clientWidth / 2, ch = stage.clientHeight / 2;
      nugs.forEach((n) => {
        if (n.offsetParent === null) return;   // hidden (mobile)
        const hx = n.offsetLeft + n.offsetWidth / 2;
        const hy = n.offsetTop + n.offsetHeight / 2;
        const dx = (cw - hx) * funnel, dy = (ch - hy) * funnel;
        const s = 1 - 0.78 * funnel;
        n.style.transform = `translate(${dx.toFixed(1)}px,${dy.toFixed(1)}px) scale(${s.toFixed(3)})`;
        n.style.opacity = (1 - clamp((funnel - 0.15) / 0.7)).toFixed(3);
      });
      if (zen) zen.style.opacity = clamp((p - 0.72) / 0.22).toFixed(3);
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  initCrmChaos();
  document.addEventListener('astro:after-swap', initCrmChaos);
</script>
