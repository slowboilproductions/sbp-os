---
// A-19 signature device — the 70s "sunset / desert-horizon" tricolor banner.
// Harvest Gold / Burnt Orange / Chocolate Brown stripes that run across the
// page and elbow UP at the right with a rounded bend (the reference's mid
// "Stripes & Gradients" swatch). In-flow header break. STATIC by design —
// the motion layer is a later, separate pass. Purely decorative (aria-hidden).
//
// The three stripes share one turn so they stay parallel and the corners
// fan (outer stripe = wider sweep) — the classic nested racing-stripe bend.
---
<div class="sb-banner" aria-hidden="true">
  <svg class="sb-banner__svg" viewBox="0 0 1440 120" preserveAspectRatio="xMidYMid meet" role="presentation" focusable="false">
    <path d="M -24 52  H 1180 Q 1204 52  1204 28 V -8" stroke="var(--gold)"   stroke-width="22" fill="none" />
    <path d="M -24 76  H 1180 Q 1228 76  1228 28 V -8" stroke="var(--orange)" stroke-width="22" fill="none" />
    <path d="M -24 100 H 1180 Q 1252 100 1252 28 V -8" stroke="var(--brown)"  stroke-width="22" fill="none" />
  </svg>
</div>

<style>
  .sb-banner { width: 100%; line-height: 0; overflow: hidden; background: transparent; }
  .sb-banner__svg { width: 100%; height: auto; display: block; max-height: 150px; }
  @media (max-width: 760px) {
    /* keep the band slim on phones; the bend rides the right edge */
    .sb-banner__svg { max-height: 96px; }
  }
</style>
